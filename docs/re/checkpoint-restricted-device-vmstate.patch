 static const Property darwin_asc_properties[] = {
     DEFINE_PROP_STRING("role", DarwinASCState, role),
     DEFINE_PROP_UINT32("mmio-size", DarwinASCState, mmio_size, 0),
@@ -583,6 +657,7 @@
