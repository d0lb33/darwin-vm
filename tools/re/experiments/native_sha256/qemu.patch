 union CRYPTO_STATE {
     uint8_t    bytes[16];
     uint32_t   words[4];
@@ -274,6 +281,7 @@ void HELPER(crypto_sha1su1)(void *vd, void *vm, uint32_t desc)
  * http://csrc.nist.gov/groups/STM/cavp/documents/shs/sha256-384-512.pdf
