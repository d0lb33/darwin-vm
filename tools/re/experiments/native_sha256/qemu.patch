+#if !DVM_NATIVE_SHA256
 static uint32_t S0(uint32_t x)
 {
     return ror32(x, 2) ^ ror32(x, 13) ^ ror32(x, 22);
@@ -294,8 +302,20 @@ static uint32_t s1(uint32_t x)
     return ror32(x, 17) ^ ror32(x, 19) ^ (x >> 10);
 }
 
+#endif
+
 void HELPER(crypto_sha256h)(void *vd, void *vn, void *vm, uint32_t desc)
 {
+#if DVM_NATIVE_SHA256
+    /* The compiler target promises host SHA2. Load all inputs before storing
+     * so architectural register aliases retain the scalar helper's semantics.
+     */
+    uint32x4_t d = vld1q_u32(vd);
+    uint32x4_t n = vld1q_u32(vn);
+    uint32x4_t m = vld1q_u32(vm);
+    vst1q_u32(vd, vsha256hq_u32(d, n, m));
+    clear_tail_16(vd, desc);
+#else
     uint64_t *rd = vd;
     uint64_t *rn = vn;
     uint64_t *rm = vm;
@@ -327,10 +347,21 @@ void HELPER(crypto_sha256h)(void *vd, void *vn, void *vm, uint32_t desc)
     rd[1] = d.l[1];
 
     clear_tail_16(vd, desc);
+#endif
 }
 
